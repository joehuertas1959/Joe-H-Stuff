# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# GovWin IQ (Deltek) credentials
# If your subscription includes API access, set GOVWIN_API_KEY instead.
# If using web login only, set USERNAME + PASSWORD.
GOVWIN_USERNAME=your.email@company.com
GOVWIN_PASSWORD=your-password-here
GOVWIN_API_KEY=

# SAM.gov API key (free at sam.gov — 100 req/day without, 1000/day with)
SAM_API_KEY=DEMO_KEY

# Optional: port override (default: 3000)
# PORT=3000
